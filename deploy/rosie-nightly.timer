# Install: copy with rosie-nightly.service to ~/.config/systemd/user/,
# then `systemctl --user enable --now rosie-nightly.timer`.
[Unit]
Description=Run Rosie's maintenance check every night

[Timer]
# Household time; matches ROSIE_TZ in .env.example. Change both together.
OnCalendar=*-*-* 03:00 America/New_York
# Run on boot if the machine was off at 03:00.
Persistent=true

[Install]
WantedBy=timers.target
