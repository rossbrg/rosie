# Where Rosie keeps its database.
ROSIE_DB=data/rosie.sqlite
# Household time zone, used to decide what "today" is.
ROSIE_TZ=America/New_York
# Person id who gets system alerts (missed nightly run).
ROSIE_ALERT_PERSON=ross
# Port for the web page (put `tailscale serve` in front of it).
PORT=8787
# Local development only: act as this login for requests to localhost without a Tailscale header.
# `serve` refuses to start with it unless ROSIE_DEV=1.
# ROSIE_DEV=1
# ROSIE_DEV_LOGIN=ross@example.com

# Email via Resend. Set both or neither. Unsent messages wait in the queue until it's set up.
# RESEND_API_KEY=
# ROSIE_EMAIL_FROM=Rosie <rosie@example.com>

# Print messages instead of sending them (local development only).
# ROSIE_CONSOLE_CHANNELS=1

# Phone push via ntfy. Each person's topic is set in seed/household.local.json.
# NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=

# "Tell Rosie": the box on the page that reads plain-language messages. Off without a key.
# ANTHROPIC_API_KEY=
# Model that reads the messages (default claude-opus-5-5). `bun run eval` before changing it.
# ROSIE_MODEL=
